# TheftGuard AI — Frontend Environment Template
# Copy this file to .env.local to configure your local environment:
#   cp .env.example .env.local
#
# IMPORTANT:
# - Only use your public Project URL and 'anon' key here.
# - NEVER put a service_role key or database password in frontend configuration.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
