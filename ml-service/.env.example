# ==============================================================================
# TheftGuard AI — Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env in the ml-service folder:
#   copy .env.example .env
#
# IMPORTANT:
# - NEVER commit .env to version control or git.
# - NEVER share your database password in chat or commit messages.
# ==============================================================================

# Model and service settings
THEFTGUARD_MODEL_PATH=validated_candidate_pipeline.joblib
THEFTGUARD_ENABLE_DOCS=1
THEFTGUARD_MAX_BODY_BYTES=20971520

# Supabase PostgreSQL connection string (Session Pooler)
# Format:
#   postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# Parameters:
# - Driver:   postgresql+psycopg:// (psycopg v3)
# - Host:     aws-0-[region].pooler.supabase.com (Supabase Session Pooler host from your dashboard)
# - Port:     5432 (Session mode)
# - Database: postgres
# - SSL:      sslmode=require
#
# Example (replace placeholders):
# THEFTGUARD_DATABASE_URL=postgresql+psycopg://postgres.abcdefghijklm:MySecretPassword123@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
THEFTGUARD_DATABASE_URL=
